{
  "name": "codex-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local API bridge and observability console for codex app-server.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.mjs",
    "baseline": "npm test && npm run smoke:mobile",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:mobile": "node scripts/mobile-smoke-test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.139.0",
    "swagger-ui-dist": "^5.32.6",
    "web-push": "^3.6.7"
  }
}
